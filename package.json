{
  "name": "charts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:pptx": "esbuild scripts/verify-pptx.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-verify/verify.cjs --log-level=warning && node dist-verify/verify.cjs",
